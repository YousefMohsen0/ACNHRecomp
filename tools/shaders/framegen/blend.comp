#version 450
// Low-cost midpoint for mobile GPUs: one full-resolution pass, without luma pyramids or motion search.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform mediump sampler2D prevc;
layout(set = 0, binding = 1) uniform mediump sampler2D curc;
layout(set = 0, binding = 4, rgba8) uniform writeonly mediump image2D dst;
layout(push_constant) uniform P {
    ivec4 size;
    vec4 a;
    vec4 b;
} p;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, p.size.xy))) return;
    mediump vec3 a = texelFetch(prevc, q, 0).rgb;
    mediump vec3 b = texelFetch(curc, q, 0).rgb;
    imageStore(dst, q, vec4(0.5 * (a + b), 1.0));
}
